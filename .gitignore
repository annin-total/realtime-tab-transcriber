.env*
!.env.example
*.local
*.local.*
local/
*/local/
secrets/
*/secrets/
credentials/
*/credentials/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# eslint
.eslintcache
.claude/settings.local.json
pr-body.md
