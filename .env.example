# OpenAI API（サーバー専用。ブラウザには渡さない）
OPENAI_API_KEY=

# 任意: ヘッダ OpenAI-Organization に渡す値（表示名「terasawaLocal」等は不可）
# Platform → Settings → Organization → Organization ID の「org_…」をそのまま貼る
# 未設定ならヘッダは送らない（キー既定の org のみで動く）
# OPENAI_ORGANIZATION=org_xxxxxxxx

# 任意: transcription_sessions で使うモデル（未設定時はコード既定の gpt-4o-transcribe）
# 低遅延ストリーミング特化に切り替える場合のみ gpt-realtime-whisper 等を指定（要 GA 経路）
# OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper

# 画面アクセス用の共有パスコード（PR-03 の認証 API で使用）
APP_PASSCODE=

# 認証 Cookie 署名用の秘密鍵（十分な長さのランダム文字列を推奨）
AUTH_SECRET=
